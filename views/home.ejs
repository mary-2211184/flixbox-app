<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FlixBox — Watch Live TV, Sports & Premium Streams</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <div class="logo-container">
      <div class="logo">Flix<span>Box</span></div>
      <nav class="nav-links">
        <a href="/" class="nav-item active">Home</a>
        <a href="#" class="nav-item">Live TV</a>
        <a href="#" class="nav-item">Sports</a>
        <a href="#" class="nav-item">Movies</a>
      </nav>
    </div>
    
    <div class="auth-buttons">
      <% if (user) { %>
        <a href="/upload" class="btn primary-btn">➕ Go Live</a>
        <a href="/logout" class="btn">Logout</a>
      <% } else { %>
        <a href="/login" class="btn">Login</a>
        <a href="/signup" class="btn primary-btn">Register</a>
      <% } %>
    </div>
  </header>

  <div class="hero-spotlight">
    <div class="hero-content">
      <span class="hero-badge">⚡ Streaming Live</span>
      <h1>Grand Finale T20 International Series</h1>
      <p>Stream ultra low-latency match feeds directly from the field with stable adaptive multi-bitrate processing engines.</p>
      <a href="#" class="btn primary-btn">Stream Live Feed Now</a>
    </div>
  </div>

  <main class="main-layout-container">
    <% if (categories.length === 0) { %>
      <div style="text-align: center; padding: 60px; color: var(--text-muted);">
        <p>No streams or configurations found in your distribution network.</p>
        <% if (user) { %>
          <a href="/upload" class="btn primary-btn">Deploy First Stream Target</a>
        <% } %>
      </div>
    <% } %>

    <% categories.forEach(cat => { %>
      <section class="category-section">
        <div class="category-title-flex">
          <h2>🍿 <%= cat %></h2>
        </div>
        
        <div class="video-slider-track">
          <% videos.filter(v => v.category === cat).forEach(v => { %>
            <div class="video-card">
              <div class="thumbnail-canvas">
                📺
                <div class="live-indicator-tag">
                  <div class="live-dot"></div> Live
                </div>
              </div>
              <div class="card-metadata">
                <h3><%= v.title %></h3>
                <div class="badge-wrapper">
                  <% if (v.isPremium) { %>
                    <span class="badge access-badge badge-premium">Premium</span>
                  <% } else { %>
                    <span class="badge access-badge badge-free">Free Feed</span>
                  <% } %>
                  <a href="/watch/<%= v._id %>" class="action-player-link">Watch ➔</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </main>

</body>
</html>